# ============================================================
# Backend Environment Variables — copy to backend/.env
# ============================================================

# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Embeddings ──────────────────────────────────────────────
# Primary: Voyage AI (voyage-3-large, 1024-dim) — recommended
VOYAGE_API_KEY=your-voyage-api-key-here

# Fallback: OpenAI (text-embedding-3-small, 1536-dim)
# If using OpenAI, set EMBEDDING_DIMENSION=1536 and update vector(1024) in schema.sql
OPENAI_API_KEY=
EMBEDDING_DIMENSION=1024

# ── Groq (LLM for answer generation) ────────────────────────
# Free tier at console.groq.com — supports llama-3.3-70b-versatile
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Rate Limiting ───────────────────────────────────────────
QUERY_RATE_LIMIT=10/minute
MAX_RETRIEVED_CHUNKS=5

# ── App Config ──────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app

# ── Evaluation (RAGAS) ──────────────────────────────────────
# org_id whose documents will be used when building the eval dataset
EVAL_ORG_ID=your-org-uuid-here

# ── Slack (optional — disabled by default) ──────────────────
# Uncomment and fill in when you're ready to enable the Slack bot
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_SIGNING_SECRET=your-signing-secret
# SLACK_APP_TOKEN=xapp-your-app-token
