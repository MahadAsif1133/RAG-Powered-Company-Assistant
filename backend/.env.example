# ============================================================
# Backend Environment Variables — copy to backend/.env
# ============================================================

# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Embeddings ──────────────────────────────────────────────
# Primary: Voyage AI (voyage-3-large, 1024-dim) — recommended
VOYAGE_API_KEY=your-voyage-api-key-here

# Fallback: OpenAI (text-embedding-3-small, 1536-dim)
# If using OpenAI, set EMBEDDING_DIMENSION=1536 and update vector(1024) in schema.sql
OPENAI_API_KEY=
EMBEDDING_DIMENSION=1024

# ── LLM provider ────────────────────────────────────────────
# "groq" (default) or "anthropic" (optional path, kept for later)
LLM_PROVIDER=groq

# Groq (free tier available at console.groq.com)
GROQ_API_KEY=your-groq-api-key-here
# Pick a model from Groq's CURRENT list: https://console.groq.com/docs/models
# (model names change over time, so none is hardcoded in the code)
GROQ_MODEL=your-groq-model-name-here
# Retries with exponential backoff on rate limits / transient errors
LLM_MAX_RETRIES=3

# Optional Anthropic path (only used when LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# ── Ingestion ───────────────────────────────────────────────
# llamaindex (default; auto-falls back to the legacy parser on error) | legacy
INGESTION_PIPELINE=llamaindex

# ── Rate Limiting & Caching (Redis optional) ────────────────
QUERY_RATE_LIMIT=10/minute
MAX_RETRIEVED_CHUNKS=5
# Optional Redis URL. If left empty, the app runs without caching and uses in-memory per-IP rate limiting.
REDIS_URL=
CACHE_TTL_SECONDS=3600

# ── App Config ──────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app

# ── Evaluation (RAGAS) ──────────────────────────────────────
# org_id whose documents will be used when building the eval dataset
EVAL_ORG_ID=your-org-uuid-here

# ── MCP Server (optional — separate entry point: python -m app.mcp_server) ──
# Organization UUID that the MCP server is scoped to (never queries across tenants)
MCP_ORG_ID=

# ── Slack (optional — disabled by default) ──────────────────
# Uncomment and fill in when you're ready to enable the Slack bot
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_SIGNING_SECRET=your-signing-secret
# SLACK_APP_TOKEN=xapp-your-app-token
