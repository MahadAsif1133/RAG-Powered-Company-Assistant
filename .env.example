# ============================================================
# Company Knowledge Assistant — Environment Variables
# ============================================================
# Copy this file to backend/.env and fill in real values.
# NEVER commit real values to version control.

# ── Supabase ────────────────────────────────────────────────
# Base URL of your Supabase project (e.g., https://<project-ref>.supabase.co)
SUPABASE_URL=
# Server-side Supabase service-role key (bypasses RLS; never expose client-side)
SUPABASE_SERVICE_ROLE_KEY=
# Public Supabase anon key used for JWT verification and client auth
SUPABASE_ANON_KEY=

# ── Embeddings ──────────────────────────────────────────────
# Optional Hugging Face token for Qwen embeddings via InferenceClient
HF_TOKEN=
# Hugging Face embedding model identifier (default in code: Qwen/Qwen3-Embedding-8B)
HF_EMBEDDING_MODEL=
# Hugging Face inference provider name (default in code: deepinfra)
HF_EMBEDDING_PROVIDER=
# Voyage AI API key for 1024-dim voyage-3-large embeddings (used when HF_TOKEN is unset or fails)
VOYAGE_API_KEY=
# Optional OpenAI API key for fallback text-embedding-3-small embeddings
OPENAI_API_KEY=
# Vector dimension stored in pgvector (1024 for Qwen/Voyage, 1536 for OpenAI)
EMBEDDING_DIMENSION=

# ── LLM Provider ────────────────────────────────────────────
# Which LLM provider to use for answer generation: "groq" (default) or "anthropic"
LLM_PROVIDER=
# Groq API key for chat completions when LLM_PROVIDER=groq
GROQ_API_KEY=
# Groq model identifier from https://console.groq.com/docs/models (no model is hardcoded in code)
GROQ_MODEL=
# Number of exponential-backoff retries on LLM rate-limit or transient errors (default: 3)
LLM_MAX_RETRIES=
# Optional Anthropic API key (only used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# Optional Anthropic model identifier (only used when LLM_PROVIDER=anthropic)
ANTHROPIC_MODEL=

# ── Ingestion, Rate Limiting & Caching ──────────────────────
# Document ingestion pipeline mode: "llamaindex" (default, with legacy fallback) or "legacy"
INGESTION_PIPELINE=
# Per-IP and per-organization query rate limit specification (default: 10/minute)
QUERY_RATE_LIMIT=
# Maximum number of top chunks retrieved from pgvector per query (default: 5)
MAX_RETRIEVED_CHUNKS=
# Minimum cosine similarity score required for a chunk to be returned (default: 0.3)
SIMILARITY_THRESHOLD=
# Optional Redis connection URL for per-org answer caching and rate limiting (disabled if empty)
REDIS_URL=
# Time-to-live in seconds for cached query answers in Redis (default: 3600)
CACHE_TTL_SECONDS=

# ── MCP Server (optional — separate entry point) ────────────
# Organization UUID that the standalone MCP server (python -m app.mcp_server) is pinned to
MCP_ORG_ID=

# ── File Storage (optional S3) ──────────────────────────────
# Storage backend for raw uploaded files: "supabase" (default no-op) or "s3"
STORAGE_BACKEND=
# Target AWS S3 bucket name when STORAGE_BACKEND=s3
S3_BUCKET_NAME=
# AWS region for the S3 client when STORAGE_BACKEND=s3
AWS_REGION=

# ── Evaluation (RAGAS, optional) ────────────────────────────
# Organization UUID whose indexed documents are queried when building the RAGAS evaluation dataset
EVAL_ORG_ID=

# ── Slack Bot (optional) ────────────────────────────────────
# Slack bot user OAuth token (xoxb-...)
SLACK_BOT_TOKEN=
# Slack app signing secret for verifying incoming requests
SLACK_SIGNING_SECRET=
# Slack app-level token (xapp-...) required for Socket Mode
SLACK_APP_TOKEN=

# ── App Config ──────────────────────────────────────────────
# Runtime environment name ("development" enables /docs and /redoc; "production" disables them)
ENVIRONMENT=
# Application logging level (e.g., INFO, DEBUG, WARNING)
LOG_LEVEL=
# Comma-separated list of allowed CORS origins for the FastAPI backend
CORS_ORIGINS=
