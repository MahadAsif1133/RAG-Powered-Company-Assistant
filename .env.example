# ============================================================
# Company Knowledge Assistant — Environment Variables
# ============================================================
# Copy this file to .env in each sub-directory (backend/, frontend/)
# and fill in real values. NEVER commit real values to version control.

# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Embeddings (pick ONE; set the other to empty) ───────────
# Primary: Voyage AI (voyage-3-large, 1024-dim vectors)
VOYAGE_API_KEY=your-voyage-api-key-here

# Fallback: OpenAI (text-embedding-3-small, 1536-dim)
# If using OpenAI, also update EMBEDDING_DIMENSION in backend config to 1536
OPENAI_API_KEY=

# ── Anthropic (Claude) ──────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Slack ───────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token   # Required for Socket Mode

# ── App Config ──────────────────────────────────────────────
ENVIRONMENT=development               # development | production
LOG_LEVEL=INFO
