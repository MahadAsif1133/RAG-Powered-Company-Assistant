# ============================================================
# Company Knowledge Assistant — Environment Variables
# ============================================================
# Copy this file to .env in each sub-directory (backend/, frontend/)
# and fill in real values. NEVER commit real values to version control.

# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Embeddings (pick ONE; set the others to empty) ──────────
# Option 1: Hugging Face InferenceClient (Qwen/Qwen3-Embedding-8B via deepinfra)
HF_TOKEN=
HF_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
HF_EMBEDDING_PROVIDER=deepinfra

# Option 2: Voyage AI (voyage-3-large, 1024-dim vectors)
VOYAGE_API_KEY=your-voyage-api-key-here

# Fallback: OpenAI (text-embedding-3-small, 1536-dim)
# If using OpenAI, also update EMBEDDING_DIMENSION in backend config to 1536
OPENAI_API_KEY=

# ── LLM (Groq by default) ───────────────────────────────────
LLM_PROVIDER=groq                      # groq (default) | anthropic (optional)
GROQ_API_KEY=your-groq-api-key-here
# Pick a model from Groq's CURRENT list: https://console.groq.com/docs/models
GROQ_MODEL=your-groq-model-name-here
# Optional Anthropic path (only if LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# ── Ingestion & Caching (optional) ──────────────────────────
INGESTION_PIPELINE=llamaindex          # llamaindex | legacy
REDIS_URL=                             # optional: redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# ── MCP Server (optional — separate entry point) ────────────
MCP_ORG_ID=

# ── File Storage (optional S3; default "supabase") ──────────
STORAGE_BACKEND=supabase               # supabase (default) | s3
S3_BUCKET_NAME=
AWS_REGION=

# ── Slack ───────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token   # Required for Socket Mode

# ── App Config ──────────────────────────────────────────────
ENVIRONMENT=development               # development | production
LOG_LEVEL=INFO
